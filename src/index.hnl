--- otlp — OTLP telemetry client. `.hnl` contract; impl = `ffi.call` into a
--- native exporter (a `-c` backend — `lib-otlp` Rust impls behind the FFI
--- registry). The connection is a VALUE: `otlp.configure(url) -> conn`,
--- subsequent ops take `conn` — pure-shape handle-passing, not ambient
--- module state (like `kv_map` store-as-value).
cap "otlp.configure"
cap "otlp.start_span"
cap "otlp.end_span"
cap "otlp.set_attribute"
cap "otlp.add_event"
cap "otlp.record_log"
cap "otlp.record_metric"
cap "otlp.flush"
cap "otlp.shutdown"
op "otlp.configure" : Value -> Value
  guarantee: True
op "otlp.start_span" : (Value * String) -> Value
  guarantee: True
op "otlp.end_span" : Value -> Value
  guarantee: True
op "otlp.set_attribute" : (Value * Value) -> Value
  guarantee: True
op "otlp.add_event" : (Value * Value) -> Value
  guarantee: True
op "otlp.record_log" : (Value * Value) -> Value
  guarantee: True
op "otlp.record_metric" : (Value * Value) -> Value
  guarantee: True
op "otlp.flush" : Value -> Value
  guarantee: True
op "otlp.shutdown" : Value -> Value
  guarantee: True

from "ffi" import * as ffi

export configure := (url) ~> ffi.call("otlp_c.configure", url)
export start_span := (conn, name) ~> ffi.call("otlp_c.start_span", conn, name)
export end_span := (span) ~> ffi.call("otlp_c.end_span", span)
export set_attribute := (conn, kv) ~> ffi.call("otlp_c.set_attribute", conn, kv)
export add_event := (span, ev) ~> ffi.call("otlp_c.add_event", span, ev)
export record_log := (conn, log) ~> ffi.call("otlp_c.record_log", conn, log)
export record_metric := (conn, metric) ~> ffi.call("otlp_c.record_metric", conn, metric)
export flush := (conn) ~> ffi.call("otlp_c.flush", conn)
export shutdown := (conn) ~> ffi.call("otlp_c.shutdown", conn)
