--- otlp — OTLP telemetry client. `.hnl` contract; impl = native `otlp_c.*`
--- ops (a `-c` backend — `lib-otlp` Rust impls behind the `otlp_c` module).
--- `otlp_c` ops are STATEFUL: `configure(config)` sets the connection,
--- `start_span(name)` returns the span id — conn is internal to the state.
--- The `.hnl` contract exposes conn-as-value shape; conn is a token (the url)
--- that the arrows drop when forwarding to the stateful backend ops.
--- Payload records (2nd arg of the record-taking fields) carry the backend
--- op's positional args as named fields: `kv` = {key, value},
--- `ev` = {name, attributes}, `log` = {level, message, attributes},
--- `metric` = {name, value, kind?, attributes?} (the whole record rides
--- along as the backend's options object).
cap "otlp.configure"
cap "otlp.start_span"
cap "otlp.end_span"
cap "otlp.set_attribute"
cap "otlp.add_event"
cap "otlp.record_log"
cap "otlp.record_metric"
cap "otlp.flush"
cap "otlp.shutdown"
op "otlp.configure" : Value -> Value
  guarantee: True
op "otlp.start_span" : (Value * String) -> Value
  guarantee: True
op "otlp.end_span" : Value -> Value
  guarantee: True
op "otlp.set_attribute" : (Value * Value) -> Value
  guarantee: True
op "otlp.add_event" : (Value * Value) -> Value
  guarantee: True
op "otlp.record_log" : (Value * Value) -> Value
  guarantee: True
op "otlp.record_metric" : (Value * Value) -> Value
  guarantee: True
op "otlp.flush" : Value -> Value
  guarantee: True
op "otlp.shutdown" : Value -> Value
  guarantee: True

from "otlp_c" import * as otlp_c

do {
  { configure: (url) ~> { otlp_c.configure({endpoint: url}); {endpoint: url} },
    start_span: (conn, name) ~> otlp_c.start_span(name),
    end_span: (span) ~> otlp_c.end_span(span),
    set_attribute: (span, kv) ~> otlp_c.set_attribute(span, kv.key, kv.value),
    add_event: (span, ev) ~> otlp_c.add_event(span, ev.name, ev.attributes),
    record_log: (conn, log) ~> otlp_c.record_log(log.level, log.message, log.attributes),
    record_metric: (conn, metric) ~> otlp_c.record_metric(metric.name, metric.value, metric),
    flush: (conn) ~> otlp_c.flush(()),
    shutdown: (conn) ~> otlp_c.shutdown(()) }
}
